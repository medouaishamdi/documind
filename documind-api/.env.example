GEMINI_API_KEY=
PORT=4500
CHAT_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001

# Retrieval: hybrid (default), dense or bm25
RETRIEVAL_MODE=hybrid

# Abuse protection (per client IP, per minute)
QUERIES_PER_MINUTE=20
UPLOADS_PER_MINUTE=5
# Max questions per day paid with the server key above (0 = unlimited).
# Visitors who paste their own key in the app are not counted.
SERVER_KEY_DAILY_QUERIES=0
# Set to 1 when running behind a reverse proxy (nginx, Caddy) so limits apply per visitor
TRUST_PROXY=
